{
  "name": "pinevents",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev:mobile\" \"npm run dev:server\"",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "dev:server": "npm --workspace apps/server run dev",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
